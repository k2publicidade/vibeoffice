# Supabase Configuration
# Obter em: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# IMPORTANTE: NÃO use SUPABASE_SERVICE_ROLE_KEY no frontend!
# Essa chave bypassa todas as políticas de segurança (RLS) e só deve
# ser usada em scripts server-side administrativos (ex: seed script).
# A aplicação usa apenas NEXT_PUBLIC_SUPABASE_ANON_KEY para operações client-side.

# Configurações da aplicação
NEXT_PUBLIC_APP_NAME=VIBEDISTRO Intranet
NEXT_PUBLIC_APP_URL=http://localhost:3000
